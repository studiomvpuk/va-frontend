.next/
out/
coverage/
storybook-static/
# Secrets. The pattern is `.env*`, not `.env` — a bare `.env` leaves
# `.env.local`, `.env.production`, `.env.backup` and every other variant
# tracked, which is how a key reaches a public repository. Only the example,
# which holds no values, is exempt.
.env
.env.*
!.env.example
*.log
src/lib/api-types.ts

# Build artifacts. tsbuildinfo is TypeScript's incremental cache — it is machine
# and path specific, changes on every build, and conflicts on every merge.
*.tsbuildinfo
next-env.d.ts

# macOS
.DS_Store
